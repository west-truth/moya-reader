COMPOSE_PROJECT_NAME=moya-reader
HOST=127.0.0.1
PORT=8787
WEB_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
SERVER_EXPOSURE=loopback
# When SERVER_EXPOSURE=external, set a long random READER_AUTH_TOKEN.
# Leave DATABASE_URL empty to derive it from POSTGRES_* inside Compose.
DATABASE_URL=
POSTGRES_USER=noveldesk
# Required when compose.public.yaml is used. Base loopback Compose falls back to a development-only value.
POSTGRES_PASSWORD=
POSTGRES_DB=noveldesk
REDIS_URL=redis://redis:6379
SERVER_DATA_DIR=/data/server
RUN_MIGRATIONS_ON_START=true
DEFAULT_USER_ID=user_dev
READER_AUTH_TOKEN=
MAX_CHUNK_BYTES=16777216
MAX_UPLOAD_BYTES=524288000
STALE_UPLOAD_MAX_AGE_MS=604800000
IMPORT_RUNNING_STALE_MS=300000
IMPORT_WORKER_CONCURRENCY=1

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=noveldesk-uploads
# Leave these empty to reuse MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Required when compose.public.yaml is used. Base loopback Compose retains development-only fallbacks.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Compose resource and bounded json-file log defaults.
WEB_MEMORY_LIMIT=256m
API_MEMORY_LIMIT=2g
WORKER_MEMORY_LIMIT=3g
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=512m
MINIO_MEMORY_LIMIT=1g
LOCAL_TTS_MEMORY_LIMIT=4g
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Same-origin hosted web traffic is automatic. Add exact entries here only for separate browser origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:1420,http://localhost:1420,http://127.0.0.1:8080,http://localhost:8080

# Server-only AI/TTS provider configuration. Do not expose these through VITE_*.
# Optional. If empty, a personal self-host key file is created under SERVER_DATA_DIR and shared by api/worker through the server-data volume.
PROVIDER_SECRET_ENCRYPTION_KEY=
AI_PROVIDER_DEFAULT=mock
AI_PROVIDER_ENABLED=mock
AI_LABELING_MODEL_ID=
AI_OPENAI_LABELING_MODEL_ID=
AI_GEMINI_AI_STUDIO_LABELING_MODEL_ID=
# Current low-cost Gemini smoke candidate: gemini-3.1-flash-lite. Avoid the shut-down gemini-3.1-flash-lite-preview id.
AI_GEMINI_VERTEX_LABELING_MODEL_ID=
AI_GEMINI_AGENT_PLATFORM_LABELING_MODEL_ID=
AI_ANTHROPIC_LABELING_MODEL_ID=
AI_LABELING_MAX_INPUT_CHARACTERS=80000
AI_LABELING_MAX_OUTPUT_TOKENS=
AI_LABELING_CONTEXT_WINDOW_TOKENS=32768
AI_LABELING_CONTEXT_SAFETY_FACTOR=0.9
AI_LABELING_ESTIMATED_CHARACTERS_PER_TOKEN=1.5
AI_LABELING_CONTEXT_HALO_PARAGRAPHS=2
AI_LABELING_TEMPERATURE=0.2
AI_LABELING_TOP_P=
AI_LABELING_REQUEST_PROFILE=chapter-labeling-v2-strict-tts
AI_LABELING_AUTO_REPAIR=
AI_MOCK_LABELING_MODEL_ID=mock-segment-labeler-v1
PROVIDER_WORKER_CONCURRENCY=1
PROVIDER_RUNNING_STALE_MS=7200000
# Personal-use provider spend guards. Each explicit 0 disables only that limit.
PROVIDER_MAX_ACTIVE_ATTEMPTS=4
PROVIDER_MAX_ATTEMPTS_PER_MINUTE=60
PROVIDER_MAX_ATTEMPTS_PER_UTC_DAY=1000
# Hosted UI can store provider secrets in the encrypted server store; env secrets remain supported as fallback.
TTS_PROVIDER_DEFAULT=system
TTS_PROVIDER_ENABLED=
TTS_MAX_INPUT_CHARACTERS=
TTS_MAX_SEGMENTS=
TTS_OPENAI_MODEL_ID=
TTS_OPENAI_BASE_URL=
TTS_OPENAI_VOICE_ID=
TTS_OPENAI_MAX_INPUT_CHARACTERS=
TTS_OPENAI_MAX_SEGMENTS=
TTS_ELEVENLABS_MODEL_ID=
TTS_ELEVENLABS_BASE_URL=
TTS_ELEVENLABS_VOICE_ID=
TTS_ELEVENLABS_MAX_INPUT_CHARACTERS=
TTS_ELEVENLABS_MAX_SEGMENTS=
TTS_GEMINI_MODEL_ID=
TTS_GEMINI_BASE_URL=
TTS_GEMINI_VOICE_ID=
TTS_GEMINI_MAX_INPUT_CHARACTERS=
TTS_GEMINI_MAX_SEGMENTS=
TTS_GEMINI_VERTEX_MODEL_ID=
TTS_GEMINI_VERTEX_LOCATION=
TTS_GEMINI_VERTEX_VOICE_ID=
TTS_GEMINI_VERTEX_MAX_INPUT_CHARACTERS=
TTS_GEMINI_VERTEX_MAX_SEGMENTS=
TTS_GOOGLE_CLOUD_MODEL_ID=
TTS_GOOGLE_CLOUD_LOCATION=
TTS_GOOGLE_CLOUD_BASE_URL=
TTS_GOOGLE_CLOUD_ACCESS_TOKEN=
TTS_GOOGLE_CLOUD_VOICE_ID=
TTS_GOOGLE_CLOUD_MAX_INPUT_CHARACTERS=
TTS_GOOGLE_CLOUD_MAX_SEGMENTS=
TTS_LOCAL_ENDPOINT_MODEL_ID=
TTS_LOCAL_ENDPOINT_URL=
TTS_LOCAL_ENDPOINT_VOICE_ID=
LOCAL_TTS_ALLOWED_HOSTS=
TTS_LOCAL_ENDPOINT_MAX_INPUT_CHARACTERS=
TTS_LOCAL_ENDPOINT_MAX_SEGMENTS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=2023-06-01
GEMINI_API_KEY=
# Compose paths are container paths. Put one service-account JSON under VERTEX_CREDENTIALS_HOST_DIR,
# or set this to /run/secrets/vertex/<file-name>.json.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_CREDENTIALS_HOST_DIR=./secrets/vertex
VERTEX_CREDENTIALS_DIR=/run/secrets/vertex
ELEVENLABS_API_KEY=

# Optional compose.local-tts.yaml sidecar. The first start downloads the MIT MeloTTS Korean model into a named volume.
LOCAL_TTS_PROVIDER_DEFAULT=local-endpoint
LOCAL_TTS_PROVIDER_ENABLED=local-endpoint
MELOTTS_COMMIT=209145371cff8fc3bd60d7be902ea69cbdb7965a
MELOTTS_DEVICE=cpu
MELOTTS_LANGUAGE=KR
MELOTTS_MAX_TEXT_CHARACTERS=20000

# Optional compose.suwayomi.yaml sidecar. The overlay adds no Suwayomi host port;
# Nginx Proxy Manager must join this pre-created external Docker network and use
# moya-web:80 for Moya and moya-suwayomi:4567 for Suwayomi (or configured aliases).
SUWAYOMI_IMAGE_TAG=stable
SUWAYOMI_TIMEZONE=Asia/Seoul
SUWAYOMI_MEMORY_LIMIT=2g
NPM_DOCKER_NETWORK=npm_proxy
MOYA_PROXY_HOSTNAME=moya-web
SUWAYOMI_PROXY_HOSTNAME=moya-suwayomi
# Required when compose.suwayomi.yaml is used. Use ui_login (recommended) or basic_auth.
SUWAYOMI_AUTH_MODE=ui_login
SUWAYOMI_AUTH_USERNAME=
SUWAYOMI_AUTH_PASSWORD=

VITE_READER_BACKEND=remote
VITE_API_BASE_URL=/api
VITE_API_AUTH_TOKEN=

# Docker Web runtime public configuration. These values are written to /runtime-config.js on each container start.
# They are browser-visible identifiers: never put an app/client secret, bearer token, or provider API secret here.
MOYA_DROPBOX_APP_KEY=
MOYA_DROPBOX_SOURCE_APP_KEY=
MOYA_GOOGLE_DRIVE_CLIENT_ID=
MOYA_GOOGLE_DRIVE_APP_ID=
MOYA_GOOGLE_DRIVE_DEVELOPER_KEY=
MOYA_SUWAYOMI_DEFAULT_URL=http://127.0.0.1:4567

# Local Vite development fallbacks. Docker prefers the matching MOYA_* values above.
# Public Dropbox OAuth app key for optional Cloud Vault App Folder sync. This is an app identifier, not an app secret.
VITE_DROPBOX_APP_KEY=
# Optional separate Dropbox app key for the read-only external source (`files.metadata.read files.content.read`).
# When omitted, the Cloud Vault public app key above is reused with a separate OAuth grant and credential envelope.
VITE_DROPBOX_SOURCE_APP_KEY=
# Google Drive selected-file source (`drive.file` only). Enable Drive API and Google Picker API in one Cloud project.
# Client ID: OAuth 2.0 Web application client with the exact local/hosted Web origins.
# App ID: numeric Google Cloud project number. Developer Key: browser API key restricted to the same origins/APIs.
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_APP_ID=
VITE_GOOGLE_DRIVE_DEVELOPER_KEY=
VITE_SUWAYOMI_DEFAULT_URL=http://127.0.0.1:4567
# Development-only source fixture used by the practical Web gate. Never enable in a production build.
VITE_ENABLE_EXTERNAL_SOURCE_SMOKE_FIXTURE=false

# Optional for local IndexedDB mode: flush local sync_outbox to a server without switching to remote repository.
VITE_SYNC_API_BASE_URL=http://127.0.0.1:8787/api
