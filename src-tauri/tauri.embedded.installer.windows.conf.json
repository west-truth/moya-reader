{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moya",
  "identifier": "app.moya.reader.embedded-candidate",
  "build": { "beforeBuildCommand": "" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "모야",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "collector-sidecar/": null,
      "../.tmp/Moya app 한글/embedded-server/": "embedded-server/"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "../.tmp/embedded-prerequisites/embedded-hooks.nsh",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
