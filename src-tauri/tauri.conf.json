{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "모야",
  "version": "0.1.0",
  "identifier": "com.local.noveldeskreader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build && pnpm collector:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "모야 - 텍스트 및 만화 뷰어",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third_party/licenses/": "third_party/licenses/",
      "collector-sidecar/": "collector-sidecar/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
