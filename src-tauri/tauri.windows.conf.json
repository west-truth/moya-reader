{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build && pnpm collector:bundle && pnpm extension:bundle-native"
  },
  "bundle": {
    "resources": {
      "extension-sidecar/": "extension-sidecar/"
    }
  },
  "app": {
    "windows": [
      {
        "title": "모야 - 텍스트 및 만화 뷰어",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ]
  }
}
