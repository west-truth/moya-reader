{
  "name": "@noveldesk/extension-contracts",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "types": "./index.ts",
  "main": "./index.ts",
  "typesVersions": {
    "*": {
      "package": [
        "./package-manifest.ts"
      ],
      "source-sdk": [
        "./source-sdk.ts"
      ],
      "source-protocol": [
        "./source-protocol.ts"
      ]
    }
  },
  "exports": {
    "./package": {
      "types": "./package-manifest.ts",
      "default": "./package-manifest.ts"
    },
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./source-sdk": {
      "types": "./source-sdk.ts",
      "default": "./source-sdk.ts"
    },
    "./source-protocol": {
      "types": "./source-protocol.ts",
      "default": "./source-protocol.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
