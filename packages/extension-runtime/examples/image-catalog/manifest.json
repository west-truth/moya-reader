{
  "packageFormat": "moya.extension.package",
  "packageVersion": 1,
  "extension": {
    "manifestVersion": 1,
    "id": "org.example.image-catalog",
    "name": "image-catalog",
    "version": "1.0.0",
    "engine": {
      "moyaApi": 1
    },
    "permissions": ["external.source.list", "external.source.download"],
    "contributes": {
      "externalSources": [
        {
          "schemaVersion": 2,
          "id": "org.example.image-catalog.source",
          "title": "image-catalog",
          "kind": "catalog",
          "runtimes": ["tauri-native", "self-host-gateway"],
          "capabilities": [
            "browse",
            "search",
            "work-details",
            "release-list",
            "release-download",
            "image-content",
            "subscriptions"
          ],
          "seriesProfile": {
            "kind": "image_series",
            "archiveFormat": "cbz"
          }
        }
      ]
    }
  },
  "execution": {
    "kind": "moya-js",
    "apiVersion": 1,
    "entry": "dist/main.js"
  },
  "requestedAccess": {
    "networkOrigins": ["https://catalog.example"],
    "storageKiB": 0
  },
  "license": "Apache-2.0"
}
