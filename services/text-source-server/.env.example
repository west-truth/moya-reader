SERVER_KEY=replace-with-a-random-key-at-least-16-characters
MOYA_ORIGIN=https://moya.example
CONTENT_PROVIDER_PROTOCOL=job-v1
CONTENT_PROVIDER_ENDPOINT=
CONTENT_PROVIDER_KEY=
# JSON list of trusted, bundled source adapters; see ADAPTERS.md for source-specific options.
SOURCE_ADAPTERS=[]
# Metadata networking only. The default uses normal Node HTTP; browser is an explicit opt-in.
SOURCE_HTTP_TRANSPORT=http
# Optional installed stable browser channel (msedge or chrome); empty uses bundled Chromium.
SOURCE_BROWSER_CHANNEL=
# Compose only: select Dockerfile.browser when using the bundled browser image.
TEXT_SOURCE_DOCKERFILE=Dockerfile
