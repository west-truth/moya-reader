{
  "name": "moya-reader",
  "version": "0.1.0",
  "description": "모야 - 텍스트 및 만화 뷰어",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{css,ts,tsx}\" \"apps/server/src/**/*.ts\" \"apps/server/*.{json,mjs}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.mjs\" \"*.{json,js,ts,mjs}\"",
    "lint": "eslint src apps/server/src apps/server/*.mjs packages/text-core scripts vite.config.ts --max-warnings 34",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "typecheck:contracts": "pnpm --filter @noveldesk/contracts typecheck",
    "typecheck:text-core": "pnpm --filter @noveldesk/text-core typecheck",
    "typecheck": "pnpm typecheck:contracts && pnpm --filter @noveldesk/epub-core typecheck && pnpm --filter @noveldesk/fixed-document-core typecheck && pnpm typecheck:text-core && pnpm typecheck:web && pnpm typecheck:server",
    "check": "pnpm check:licenses:source-release && pnpm lint && pnpm typecheck && pnpm test:deploy && pnpm check:server:production && pnpm build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "server:build": "pnpm --filter server build",
    "server:bundle": "pnpm --filter server bundle",
    "server:dev": "pnpm --filter server dev",
    "server:migrate": "pnpm --filter server migrate",
    "server:id-v2-migrate": "pnpm --filter server id-v2:migrate",
    "server:provider-smoke": "pnpm --filter server provider:smoke",
    "server:tts-smoke": "pnpm --filter server tts:smoke",
    "server:worker": "pnpm --filter server worker",
    "check:server:production": "node apps/server/build.mjs && node scripts/verify-server-production-build.mjs",
    "licenses:generate": "node scripts/production-license-inventory.mjs",
    "licenses:sync-lgpl": "node scripts/sync-lgpl-license.mjs",
    "check:licenses": "node scripts/production-license-inventory.mjs --check && node scripts/sync-lgpl-license.mjs --check",
    "check:licenses:source-release": "node scripts/production-license-inventory.mjs --source-release && node scripts/sync-lgpl-license.mjs --check",
    "check:licenses:release": "node scripts/production-license-inventory.mjs --release",
    "test": "pnpm test:deploy",
    "test:deploy": "vitest run src/test/parser.test.ts src/test/parser-source-preservation.test.ts src/test/epub-import.test.ts apps/server/src/services/import-service.test.ts apps/server/src/routes/health.test.ts apps/server/src/routes/books/source-download-routes.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@noveldesk/epub-core": "workspace:*",
    "@noveldesk/fixed-document-core": "workspace:*",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.9.0",
    "@zip.js/zip.js": "2.8.26",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noveldesk/contracts": "workspace:*",
    "@noveldesk/text-core": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
