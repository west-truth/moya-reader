{
  "name": "moya-reader",
  "version": "0.1.0",
  "description": "모야 - 텍스트 및 만화 뷰어",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "build": "tsc && vite build",
    "format": "prettier --write \"src/**/*.{css,ts,tsx}\" \"apps/server/src/**/*.ts\" \"apps/server/*.{json,mjs}\" \"packages/**/*.{json,ts}\" \"scripts/**/*.{ts,mjs}\" \"*.{json,js,ts,mjs}\"",
    "format:check": "node scripts/check-changed-format.mjs",
    "lint": "eslint src apps/server/src apps/server/*.mjs packages/extension-contracts packages/text-core scripts vite.config.ts --max-warnings 34",
    "check:css": "node scripts/check-css.mjs",
    "check:cycles": "node scripts/check-dependency-cycles.mjs",
    "check:contract-boundaries": "node scripts/check-contract-boundaries.mjs",
    "check:file-size": "node scripts/check-file-size-ratchet.mjs",
    "check:web-bundle": "node scripts/check-web-bundle-budget.mjs",
    "diagnose:file-size": "node scripts/check-file-size-ratchet.mjs",
    "diagnose:web-bundle": "node scripts/check-web-bundle-budget.mjs",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p apps/server/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:contracts": "pnpm --filter @noveldesk/contracts typecheck",
    "typecheck:text-core": "pnpm --filter @noveldesk/text-core typecheck",
    "typecheck": "pnpm typecheck:contracts && pnpm --filter @noveldesk/extension-contracts typecheck && pnpm --filter @noveldesk/epub-core typecheck && pnpm --filter @noveldesk/document-series-core typecheck && pnpm --filter @noveldesk/fixed-document-core typecheck && pnpm typecheck:text-core && pnpm typecheck:web && pnpm typecheck:server && pnpm typecheck:scripts",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "pnpm check:web-server && pnpm check:rust",
    "check:desktop": "pnpm build && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "server:build": "pnpm --filter server build",
    "server:bundle": "pnpm --filter server bundle",
    "server:dev": "pnpm --filter server dev",
    "server:migrate": "pnpm --filter server migrate",
    "server:id-v2-migrate": "pnpm --filter server id-v2:migrate",
    "server:provider-smoke": "pnpm --filter server provider:smoke",
    "server:tts-smoke": "pnpm --filter server tts:smoke",
    "server:worker": "pnpm --filter server worker",
    "check:server:production": "node apps/server/build.mjs && node scripts/verify-server-production-build.mjs",
    "check:desktop-vertex-contract": "pnpm --filter server exec tsx ../../scripts/desktop-vertex-contract-smoke.ts",
    "fixture:large": "node scripts/generate-large-novel-fixture.mjs",
    "check:hosted": "node scripts/verify-hosted-deploy.mjs",
    "check:hosted:e2e": "node scripts/hosted-e2e.mjs",
    "check:hosted:ai-workflow": "node scripts/hosted-e2e.mjs --include-ai-workflow",
    "check:hosted:live": "node scripts/hosted-live-smoke.mjs",
    "check:mobile-readiness": "node scripts/verify-mobile-readiness.mjs",
    "check:mobile-readiness:strict": "node scripts/verify-mobile-readiness.mjs --strict",
    "check:android-rust": "node scripts/check-android-rust.mjs",
    "check:android-rust:strict": "node scripts/check-android-rust.mjs --strict",
    "licenses:generate": "node scripts/production-license-inventory.mjs",
    "licenses:sync-lgpl": "node scripts/sync-lgpl-license.mjs",
    "check:licenses": "node scripts/production-license-inventory.mjs --check && node scripts/sync-lgpl-license.mjs --check",
    "check:licenses:release": "node scripts/production-license-inventory.mjs --release",
    "check:large-local": "node scripts/local-large-import-smoke.mjs",
    "check:reader-ui": "node scripts/reader-ui-smoke.mjs",
    "check:book-enrichment-ui": "node scripts/book-enrichment-ui-smoke.mjs",
    "check:reader-performance": "node scripts/performance/reader-performance-gate.mjs",
    "test": "vitest run",
    "test:import-pages": "vitest run apps/server/src/services/import-page-reuse.test.ts apps/server/src/services/import-measurements.test.ts apps/server/src/services/object-storage.test.ts apps/server/src/services/import-page-reuse.integration.test.ts --maxWorkers=2",
    "tauri:dev": "tauri dev",
    "collector:bundle": "node scripts/build-webnovel-metadata-collector-sidecar.mjs",
    "tauri:build": "tauri build",
    "tauri:android:sync-provider-plugin": "node scripts/sync-tauri-android-provider-secret-plugin.mjs",
    "tauri:android:init": "tauri android init --ci && pnpm tauri:android:sync-provider-plugin",
    "tauri:android:dev": "pnpm tauri:android:sync-provider-plugin && tauri android dev",
    "tauri:android:build": "pnpm tauri:android:sync-provider-plugin && tauri android build --apk",
    "tauri:android:build:arm64-debug": "node scripts/build-android-arm64-debug.mjs",
    "tauri:android:build:x86_64-debug": "node scripts/build-android-arm64-debug.mjs --target=x86_64",
    "check:public-source": "node scripts/check-public-source-boundary.mjs",
    "check:web-server": "pnpm format:check && pnpm check:public-source && pnpm check:licenses:source-release && pnpm lint && pnpm check:css && pnpm check:contract-boundaries && pnpm typecheck && pnpm test:deploy && pnpm test:extensions-sources && pnpm test:reader-recovery && pnpm test:import-pages && pnpm check:server:production && pnpm check:hosted && pnpm build",
    "test:reader-recovery": "vitest run src/storage/rollback-db-compatibility.test.ts src/storage/exact-section-read-state.test.ts src/test/reader-state-store.test.ts src/test/exact-chapter-read-state.test.ts src/features/chapters/chapters-screen-model.test.ts src/features/book-workspace/book-workspace-commands.test.ts src/features/book-workspace/book-workspace-navigation.test.ts src/features/book-workspace/book-workspace-projection.test.ts src/features/fixed-document/use-fixed-document-progress.test.tsx src/features/external-sources/serial-work-projection.test.ts src/external-sources/link-import-reconciliation.test.ts src/external-sources/missing-book-links.test.ts apps/server/src/db/exact-chapter-read.integration.test.ts apps/server/src/db/source-book-lifecycle.integration.test.ts apps/server/src/db/migrate.integration.test.ts --maxWorkers=2",
    "check:native-parity": "node scripts/verify-native-parity.mjs",
    "check:native-source": "pnpm check:native-parity && pnpm test:native-source",
    "check:licenses:source-release": "node scripts/production-license-inventory.mjs --source-release && node scripts/sync-lgpl-license.mjs --check",
    "test:deploy": "vitest run src/test/parser.test.ts src/test/parser-source-preservation.test.ts src/test/epub-import.test.ts src/test/reader-runtime.test.ts src/test/reading-profile.test.ts src/features/reader/reader-pagination-model.test.ts src/storage/reader-page-map-store.test.ts src/test/remote-api-client.test.ts src/test/server-upload-import-service.test.ts src/features/import/import-duplicate-inspection.test.ts src/features/import/import-failure-message.test.ts src/features/library-folders/useLibraryFolderController.test.ts src/library-folders/reconcile.test.ts src/repositories/remote-backup-repository.test.ts src/repositories/remote-data-safety-repositories.test.ts apps/server/src/auth.test.ts apps/server/src/server.security.test.ts apps/server/src/queue.test.ts apps/server/src/services/import-service.test.ts apps/server/src/services/hosted-backup-archive.test.ts apps/server/src/services/hosted-backup-service.test.ts apps/server/src/services/hosted-backup-storage-safety.test.ts apps/server/src/services/object-delete-outbox.test.ts apps/server/src/services/upload-cleanup.test.ts apps/server/src/services/upload-validation.test.ts apps/server/src/services/tts-cache-maintenance.test.ts apps/server/src/routes/health.test.ts apps/server/src/routes/uploads.test.ts apps/server/src/routes/books/catalog-routes.test.ts apps/server/src/routes/books/source-download-routes.test.ts",
    "test:extensions-sources": "vitest run src/config/public-runtime-config.test.ts src/extensions/app-extension-manager.test.ts src/extensions/app-extension-runtime.test.ts src/extensions/extension-enablement-store.test.ts src/extensions/trusted-extension-registry.test.tsx src/features/extensions/ExtensionSettingsPanel.test.tsx src/cloud-vault/dropbox-oauth.test.ts src/external-sources/app-external-source-registry.test.ts src/external-sources/dropbox-cloud-file-broker.test.ts src/external-sources/dropbox-source-account-broker.test.ts src/external-sources/google-drive-source-account-broker.test.ts src/external-sources/local-state.test.ts src/external-sources/suwayomi/suwayomi-source-account-broker.test.ts src/features/external-sources/SourceHubScreen.test.tsx src/features/external-sources/useExternalSourceController.test.tsx",
    "test:native-source": "vitest run src/test/platform-runtime.test.ts src/platform/android/app-events.test.ts src/platform/android/app-navigation.test.ts src/platform/android/document-io.test.ts src/platform/android/library-folder-io.test.ts src/platform/android/system-tts.test.ts src/platform/secure-credentials.test.ts src/platform/tauri/native-book-workflow-bridge.test.ts src/platform/tauri/native-tts-cache-gateway.test.ts src/test/desktop-structured-json-provider.test.ts src/test/desktop-tts-provider.test.ts"
  },
  "dependencies": {
    "@googleworkspace/drive-picker-element": "0.7.3",
    "@noble/hashes": "2.0.1",
    "@noveldesk/document-series-core": "workspace:*",
    "@noveldesk/epub-core": "workspace:*",
    "@noveldesk/extension-contracts": "workspace:*",
    "@noveldesk/fixed-document-core": "workspace:*",
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.9.0",
    "@zip.js/zip.js": "2.8.26",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noveldesk/contracts": "workspace:*",
    "@noveldesk/text-core": "workspace:*",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.4",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
