# Public OAuth identifiers only. Never put provider keys or OAuth client secrets in VITE_*.
# Register the exact site root URL (including trailing slash) with the OAuth app.
# Dropbox Cloud Vault: App Folder app with account_info.read, files.content.read,
# files.content.write, files.metadata.read, files.metadata.write.
VITE_DROPBOX_APP_KEY=
# Optional separate Full Dropbox read-only app for browsing existing files.
VITE_DROPBOX_SOURCE_APP_KEY=
# Optional Google Drive selected-file import (Google Picker, drive.file).
VITE_GOOGLE_DRIVE_CLIENT_ID=
VITE_GOOGLE_DRIVE_APP_ID=
VITE_GOOGLE_DRIVE_DEVELOPER_KEY=
# Project Pages: /moya-reader/; user Pages or custom domain: /
WEB_BASE_PATH=/
# Optional HTTPS installer/release URL. Empty shows the public release listing.
VITE_DESKTOP_DOWNLOAD_URL=
